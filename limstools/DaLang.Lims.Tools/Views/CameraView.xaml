<Window x:Class="DaLang.Lims.Tools.Views.CameraView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DaLang.Lims.Tools.Views"
        xmlns:lc="clr-namespace:DaLang.Lims.Tools.Converters"
        mc:Ignorable="d"
        Icon="/Resources/dalang.ico"
        xmlns:wpfmedia="clr-namespace:WPFMediaKit.DirectShow.Controls;assembly=WPFMediaKit"
        Title="CameraView" Height="450" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
        <lc:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Window.Resources>
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,10,10,5">
                <ComboBox Name="cb" Width="200" SelectionChanged="cb_SelectionChanged"></ComboBox>
                <Button Click="Button_Click" DockPanel.Dock="top" Height="45" Content="拍照" Margin="15,0,0,0"/>
            </StackPanel>
            <Viewbox x:Name="mainViewbox" Stretch="Uniform" StretchDirection="Both" MouseLeftButtonDown="Button_Click" >
                <wpfmedia:VideoCaptureElement x:Name="vce" Margin="10,10,10,10"></wpfmedia:VideoCaptureElement>
            </Viewbox>
        </StackPanel>
    </Grid>
</Window>
