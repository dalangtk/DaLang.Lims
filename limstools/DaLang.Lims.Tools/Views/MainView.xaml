<Window x:Class="DaLang.Lims.Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DaLang.Lims.Tools"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        xmlns:viewmodels="clr-namespace:DaLang.Lims.Tools.ViewModels"
        Icon="/Resources/dalang.ico"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        WindowState="Minimized"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Grid.Row="0" IsEnabled="{Binding CanStart,Mode=TwoWay}" Command="{Binding StartServiceCommand}" Content="启动服务" ></Button>
            <Button Grid.Row="0" Content="停止服务" IsEnabled="{Binding CanStop,Mode=TwoWay}" Command="{Binding StopServiceCommand}"></Button>
            <Button Grid.Row="0" Content="拍照" x:Name="OpenCamera" Click="OpenCamera_Click"></Button>
        </StackPanel>
        <hc:TextBox HorizontalContentAlignment="Left"
                        Grid.Row="1"
                        VerticalContentAlignment="Top" 
                        IsReadOnly="True"
                        TextChanged="TextBox_TextChanged"
                        VerticalScrollBarVisibility="Visible"
                        TextWrapping="Wrap"
                        Text="{Binding LogText}">
        </hc:TextBox>

        <hc:NotifyIcon Token="limstool" x:Name="NotifyIconContextContent" Text="HandyControl" IsBlink="{Binding ContextContentIsBlink}" Visibility="{Binding ContextContentIsShow,Converter={StaticResource Boolean2VisibilityConverter}}" Icon="/Resources/dalang.ico">
            <hc:NotifyIcon.ContextContent>
                <Border CornerRadius="4" Margin="10" Background="{DynamicResource RegionBrush}" Effect="{StaticResource EffectShadow2}">
                    <StackPanel VerticalAlignment="Center" Margin="16">

                        <StackPanel Margin="0,0,0,0" HorizontalAlignment="Center" Orientation="Vertical">
                            <Button Command="hc:ControlCommands.PushMainWindow2Top" MinWidth="100" Content="打开"/>
                            <Button Command="hc:ControlCommands.ShutdownApp" Margin="0,5,0,0"  MinWidth="100" Style="{StaticResource ButtonPrimary}" Content="退出"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </hc:NotifyIcon.ContextContent>
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="Click">
                    <hc:EventToCommand Command="hc:ControlCommands.PushMainWindow2Top"/>
                </hc:EventTrigger>
                <hc:EventTrigger EventName="MouseDoubleClick">
                    <hc:EventToCommand Command="{Binding MouseCmd}" CommandParameter="MouseDoubleClick"/>
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </hc:NotifyIcon>
    </Grid>
</Window>
