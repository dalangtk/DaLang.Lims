{
  "DbConfig": {

    //程序集名称，自动获取实体表
    "assemblyNames": [
      "DaLang.Lims.Web.Framework",
      "DaLang.Lims.BaseData.Domain",
      "DaLang.Lims.Shared.Domain",
      "DaLang.Lims.Pretreatment.Domain",
      "DaLang.Lims.Exam.Domain"
    ],
    "EnableConsoleSql": true, // 启用控制台打印SQL

    "ConnectionConfigs": [
      {
        "ConfigId": "maindb", // 默认库标识-禁止修改
        "DbType": "MySql", // MySql、SqlServer、Sqlite、Oracle、PostgreSQL、Dm、Kdbndp、Oscar、MySqlConnector、Access、OpenGauss、QuestDB、HG、ClickHouse、GBase、Odbc、Custom
        "ConnectionString": "Server=localhost; Port=3306; Database=dlims; Uid=root; Pwd=a3%c0df!@123,$; Charset=utf8mb4;SslMode=none;Min pool size=1", // 库连接字符串
