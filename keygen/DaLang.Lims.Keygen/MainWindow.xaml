<Window x:Class="DaLang.Lims.Keygen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DaLang.Lims.Keygen"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="注册码">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="识别码">
                        <TextBox x:Name="txtIdentifier"></TextBox>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="注册码">
                        <TextBox x:Name="txtRegistrationCode"></TextBox>
                    </GroupBox>
                    <Button Grid.Row="2" Width="120" Height="40" Content="Gen" Click="GenButton_Click"></Button>
                </Grid>
            </TabItem>
            <TabItem Header="解析">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="注册码">
                        <TextBox x:Name="txtKey"></TextBox>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="解析值">
                        <TextBox x:Name="txtResove"></TextBox>
                    </GroupBox>
                    <Button Grid.Row="2" Width="120" Height="40" Content="Resove" Click="ResoveButton_Click"></Button>
                </Grid>
            </TabItem>
        </TabControl>
       

    </Grid>
</Window>
