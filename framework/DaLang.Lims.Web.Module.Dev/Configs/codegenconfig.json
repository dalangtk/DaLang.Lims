{
  //代码生成器选项配置
  //namingConvention 0 CamelCase camelCase, 1 PascalCase PascalCase, 2 SnakeCase snake_case, 3 KebabCase kebab-case, 4 ExtensionCase extension.case
  //生成的默认参数项
  "defaultOption": {
    "authorName": "DaLang.Lims",
    "backendOut": "E:\\CodeGenOutput",
    "frontendOut": "E:\\CodeGenOutput",
    "dbMigrateSqlOut": "E:\\MigrateSqls",
    "namespace": "DaLang.Lims.Web.xxx",
    // Api 分组名称
    "apiAreaName": "xxx",
    // 默认导入命名空间，多个之间用;分隔
    "usings": "",
    //后缀：列表/管理
    "menuAfterText": "管理"
  },
  //模板参数配置
  "templateOptions": [
    {
      //路径、文件名的转义符及其对应实体属性值和名称转换规则定义
      "nameReplaces": [
        {
          "flag": "_EN_",
          "propName": "EntityName",
          "namingConvention": "PascalCase"
        },
        {
          "flag": "_BO_",
          "propName": "BackendOut"
        },
        {
          "flag": "_NP_",
          "propName": "Namespace"
        }
      ],
      //模板列表
      "templates": [
        {
          "source": "_NP_.csproj.tpl",
          "outTo": "_BO_\\",
          "IsExistSkip": true
        },
        {
          "source": "_NP_.Application.csproj.tpl",
          "outTo": "_BO_\\_NP_.Application"
        },
        {
          "source": "_EN_Service.cs.tpl",
          "outTo": "_BO_\\_NP_.Application\\_EN_"
        },

        {
          "source": "_NP_.Contracts.csproj.tpl",
          "outTo": "_BO_\\_NP_.Contracts",
          "IsExistSkip": true
        },
        {
          "source": "I_EN_Service.cs.tpl",
          "outTo": "_BO_\\_NP_.Contracts\\_EN_"
        },
        {
          "source": "_EN_AddInput.cs.tpl",
          "outTo": "_BO_\\_NP_.Contracts\\_EN_\\Dto"
        },
        {
          "source": "_EN_UpdateInput.cs.tpl",
          "outTo": "_BO_\\_NP_.Contracts\\_EN_\\Dto"
        },
        {
          "source": "_EN_QueryInput.cs.tpl",
          "outTo": "_BO_\\_NP_.Contracts\\_EN_\\Dto"
        },
        {
          "source": "_EN_Dto.cs.tpl",
          "outTo": "_BO_\\_NP_.Contracts\\_EN_\\Dto"
        },

        {
          "source": "_NP_.Core.csproj.tpl",
          "outTo": "_BO_\\_NP_.Core",
          "IsExistSkip": true
        },
        {
          "source": "Default_Consts.cs.tpl",
          "outTo": "_BO_\\_NP_.Core\\Consts",
          "IsExistSkip": true
        },

        {
          "source": "_NP_domain.csproj.tpl",
          "outTo": "_BO_\\_NP_.Domain"
        },
        {
          "source": "I_EN_Repository.cs.tpl",
          "outTo": "_BO_\\_NP_.Domain\\_EN_"
        },
        {
          "source": "_EN_Entity.cs.tpl",
          "outTo": "_BO_\\_NP_.Domain\\_EN_"
        },
        {
          "source": "_NP_.Sqlsugar.Mysql.csproj.tpl",
          "outTo": "_BO_\\_NP_.Sqlsugar.Mysql",
          "IsExistSkip": true
        },
        {
          "source": "_EN_Repository.cs.tpl",
          "outTo": "_BO_\\_NP_.Sqlsugar.Mysql\\Repositories\\_EN_"
        }
      ]
    },
    {
      "isDiabled": false,
      "nameReplaces": [
        {
          "flag": "_EN_",
          "propName": "EntityName",
          "namingConvention": "KebabCase"
        },
        {
          "flag": "_AAN_",
          "propName": "ApiAreaName",
          "namingConvention": "KebabCase"
        },
        {
          "flag": "_FO_",
          "propName": "FrontendOut"
        }
      ],
      //模板列表
      "templates": [
        {
          "source": "index.vue.tpl",
          "outTo": "_FO_\\views\\_AAN_\\_EN_"
        },
        {
          "source": "_EN_-form.vue.tpl",
          "outTo": "_FO_\\views\\_AAN_\\_EN_\\components"
        },
        {
          "source": "_EN_-datacontract.ts.tpl",
          "outTo": "_FO_\\views\\_AAN_\\_EN_"
        },
        {
          "source": "_EN_.ts.tpl",
          "outTo": "_FO_\\views\\_AAN_\\_EN_"
        }
      ]
    }

  ]
}